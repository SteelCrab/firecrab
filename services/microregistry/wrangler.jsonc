{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "firecrab-microregistry",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "registry.firecrab.dev",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "REGISTRY",
      "bucket_name": "registry"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
