{
  "name": "firecrab-e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Isolated browser E2E for issue #90 (OCI import), #108 (MicroRegistry register), #146 (MicroNetwork IPv6), #303 (console session end), and OCI DHCP boot. Playwright is test-only.",
  "scripts": {
    "test": "playwright test",
    "test:import": "node scripts/test-import.mjs",
    "test:runner": "node --test scripts/test-runner.mjs scripts/test-navigation.mjs",
    "test:register": "playwright test tests/microregistry-register.spec.ts",
    "test:ipv6": "playwright test tests/network-ipv6.spec.ts",
    "test:dhcp": "playwright test tests/oci-dhcp-boot.spec.ts",
    "test:console": "playwright test tests/console-session.spec.ts",
    "test:dashboard": "playwright test --config playwright.dashboard.config.ts",
    "test:headed": "playwright test --headed",
    "install-browsers": "playwright install chromium",
    "test:host": "playwright test --config playwright.host-firecrab.config.ts",
    "test:services": "playwright test --config playwright.micro-services.config.ts",
    "test:pipe": "playwright test --config playwright.pipe.config.ts",
    "test:pipe:databases": "playwright test --config playwright.pipe.config.ts tests/pipe-databases.spec.ts",
    "test:pipe:live": "playwright test --config playwright.pipe-live.config.ts",
    "test:mocked": "playwright test --config playwright.mocked.config.ts",
    "typecheck:pipe": "tsrs -p tsconfig.pipe.json",
    "test:pools": "playwright test tests/pools.spec.ts",
    "test:schedules": "cargo test --manifest-path ../firecrab-frontend/Cargo.toml --locked forms::advanced::tests::schedule && playwright test --config playwright.mocked.config.ts tests/schedules.spec.ts",
    "test:secrets": "playwright test --config playwright.secrets.config.ts",
    "test:secrets:live": "playwright test --config playwright.secrets-live.config.ts",
    "typecheck:secrets": "tsrs -p tsconfig.secrets.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.2",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929"
  }
}
