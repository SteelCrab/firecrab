[Unit]
Description=firecrab API and dashboard
Documentation=https://github.com/pista/firecrab
After=firecrab-helper.service network-online.target
Wants=firecrab-helper.service

[Service]
Type=simple
User=@FIRECRAB_USER@
Group=@FIRECRAB_GROUP@
# Not cosmetic: the DB (data/firecrab.db) and VM artifacts (data/vms/<id>/) are
# resolved relative to the working directory. Start this anywhere else and it
# silently opens a different, empty database.
WorkingDirectory=@DATADIR@
Environment=FIRECRAB_IMAGE_ROOT=@DATADIR@/images
Environment=FIRECRAB_STATIC_ROOT=@SHAREDIR@/dashboard
# So `firecrab update`, spawned as a child of this service, resolves the same
# install layout `firecrab info` reports instead of falling back to defaults.
# PREFIX and FIRECRAB_LIBDIR are also what firecrab-helper.service exports
# to itself: the helper re-derives the layout from them and rejects an
# ApplySelfUpdate that disagrees, so both sides must be rendered from the same
# install.sh values or every apply is refused.
Environment=PREFIX=@PREFIX@
Environment=FIRECRAB_LIBDIR=@LIBDIR@
Environment=DATADIR=@DATADIR@
EnvironmentFile=-@CONFDIR@/api.env
ExecStart=@LIBDIR@/firecrab-api
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
# A stopped/failed helper may have removed its RuntimeDirectory. Keep the
# API available to report networkFailed and accept recovery retries then.
ReadWritePaths=@DATADIR@ -/run/firecrab

[Install]
WantedBy=multi-user.target
